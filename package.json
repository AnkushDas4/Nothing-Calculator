{
  "name": "nothing-calculator",
  "version": "3.1.0",
  "description": "n-calc — a Nothing OS inspired calculator, converter and Android app",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnkushDas4/Nothing-Calculator.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:engine": "node --test tests/engine.test.js",
    "test:units": "node --test tests/units.test.js",
    "build:data": "node scripts/build-data.js",
    "check:data": "node scripts/build-data.js --check",
    "build:icons": "python3 scripts/make-icons.py",
    "version:set": "node scripts/set-version.js",
    "validate": "node scripts/validate.js",
    "serve": "node scripts/serve.js",
    "android:sync": "node scripts/sync-android.js",
    "vendor:mathjs": "node scripts/vendor-mathjs.js",
    "check": "npm run check:data && npm run validate && npm test",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
